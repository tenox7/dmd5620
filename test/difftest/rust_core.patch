 //
+// Test hooks (difftest)
+//
+
+static PANIC_MSG: Mutex<String> = Mutex::new(String::new());
+
+fn dmd_guard() -> std::sync::MutexGuard<'static, Dmd> {
+    DMD.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+#[no_mangle]
+pub extern "C" fn rs_set_time(ns: u64) {
+    crate::vclock::VNOW.store(ns, std::sync::atomic::Ordering::Relaxed);
+}
+
+#[no_mangle]
+pub extern "C" fn rs_recreate() {
+    {
+        let mut g = dmd_guard();
+        *g = Dmd::new();
+    }
+    DMD.clear_poison();
+    std::panic::set_hook(Box::new(|info| {
+        let mut m = PANIC_MSG.lock().unwrap_or_else(|e| e.into_inner());
+        *m = format!("{}", info);
+    }));
+}
+
+#[no_mangle]
+pub extern "C" fn rs_set_register(reg: u8, val: u32) {
+    dmd_guard().cpu.r[(reg & 0xf) as usize] = val;
+}
+
+#[no_mangle]
+pub extern "C" fn rs_get_regs(out: *mut u32) {
+    let g = dmd_guard();
+    for i in 0..16 {
+        unsafe {
+            *out.add(i) = g.cpu.r[i];
+        }
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn rs_ram() -> *mut u8 {
+    dmd_guard().bus.ram_mut()
+}
+
+#[no_mangle]
+pub extern "C" fn rs_bbram() -> *mut u8 {
+    dmd_guard().bus.bbram_mut()
+}
+
+#[no_mangle]
+pub extern "C" fn rs_vid() -> *mut u8 {
+    dmd_guard().bus.vid_mut()
+}
+
+/// One step; 0 = ok, 1 = the core panicked (message in buf).
+#[no_mangle]
+pub extern "C" fn rs_step_checked(buf: *mut u8, len: usize) -> c_int {
+    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        dmd_guard().step();
+    }));
+    DMD.clear_poison();
+    match r {
+        Ok(()) => 0,
+        Err(_) => {
+            let m = PANIC_MSG.lock().unwrap_or_else(|e| e.into_inner());
+            let b = m.as_bytes();
+            let n = std::cmp::min(b.len(), len - 1);
+            unsafe {
+                std::ptr::copy_nonoverlapping(b.as_ptr(), buf, n);
+                *buf.add(n) = 0;
+            }
+            1
+        }
+    }
+}
